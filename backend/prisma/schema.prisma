generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PASSENGER
  DRIVER
  ADMIN
}

enum VehicleType {
  MOTO
  RAKCHA
  CAR
}

enum RideStatus {
  REQUESTED
  SEARCHING
  ACCEPTED
  DRIVER_ARRIVING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DriverVerificationStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

model User {
  id            String         @id @default(uuid())
  firstName     String
  lastName      String
  phone         String         @unique
  email         String?        @unique
  passwordHash  String
  role          UserRole       @default(PASSENGER)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  driver        Driver?
  rides         Ride[]
  ratingsGiven  Rating[]
}

model Driver {
  id                   String                    @id @default(uuid())
  userId               String                    @unique
  user                 User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentLatitude      Float?
  currentLongitude     Float?
  onlineStatus         Boolean                   @default(false)
  lastLocationUpdate   DateTime?
  rating               Float                     @default(5.0)
  totalTrips           Int                       @default(0)
  verificationStatus   DriverVerificationStatus  @default(PENDING)
  licenseNumber        String?
  licenseExpiry        DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  rides                Ride[]
  vehicles             Vehicle[]
  ratings              Rating[]
}

model Vehicle {
  id        String      @id @default(uuid())
  driverId  String
  driver    Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type      VehicleType
  plate     String?
  brand     String?
  model     String?
  color     String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([driverId])
}

model Ride {
  id                   String      @id @default(uuid())
  passengerId          String
  passenger            User        @relation(fields: [passengerId], references: [id])
  driverId             String?
  driver               Driver?     @relation(fields: [driverId], references: [id])
  vehicleId            String?
  vehicleType          VehicleType
  pickupLatitude       Float
  pickupLongitude      Float
  destinationLatitude  Float
  destinationLongitude Float
  pickupAddress        String?
  destinationAddress   String?
  distance             Float
  estimatedDuration    Int
  estimatedPrice       Float
  finalPrice           Float?
  // Road-route polyline from OSRM as a JSON array of {latitude, longitude}
  // points, in travel order — null if the ride predates this field or OSRM
  // was unreachable at creation time (Haversine fallback has no real route).
  routeGeometry        Json?
  status               RideStatus  @default(REQUESTED)
  requestedAt          DateTime    @default(now())
  acceptedAt           DateTime?
  arrivingAt           DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  rating               Rating?

  @@index([passengerId])
  @@index([driverId])
  @@index([status])
}

model Rating {
  id          String   @id @default(uuid())
  rideId      String   @unique
  ride        Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  passengerId String
  passenger   User     @relation(fields: [passengerId], references: [id])
  driverId    String
  driver      Driver   @relation(fields: [driverId], references: [id])
  score       Int
  comment     String?
  createdAt   DateTime @default(now())

  @@index([driverId])
}

model PricingConfig {
  id          String      @id @default(uuid())
  vehicleType VehicleType @unique
  baseFare    Float
  pricePerKm  Float
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model City {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  zones     Zone[]
}

model Zone {
  id        String   @id @default(uuid())
  cityId    String
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cityId, name])
  @@index([cityId])
}
